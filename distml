## 7. Database Schema (PostgreSQL Metadata & Cache Index)

PostgreSQL tracks immutable content-addressed shards (`CIDs`), dataset manifests, checkpoint lineage, and real-time node cache locality. **Zero raw training payloads are stored here.**

```sql
-- Enable UUIDs and fast array/JSON indexing
CREATE EXTENSION IF NOT EXISTS "pgcrypto";

-- 1. Immutable Shards (128MB - 256MB packed Lance / MDS / Parquet files)
CREATE TABLE shards (
    cid             TEXT PRIMARY KEY,          -- BLAKE3 (Iroh) or SHA2-256 multihash (IPFS)
    format          TEXT NOT NULL,             -- 'lance', 'mds', 'parquet'
    size_bytes      BIGINT NOT NULL,
    num_samples     INTEGER NOT NULL,
    metadata        JSONB DEFAULT '{}'::jsonb, -- e.g., {"token_count": 33554432, "domain": "code"}
    created_at      TIMESTAMPTZ DEFAULT NOW()
);

-- 2. Dataset Versions & Deterministic Shard Ordering
CREATE TABLE datasets (
    id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name            TEXT NOT NULL,
    version         TEXT NOT NULL,
    UNIQUE (name, version)
);

CREATE TABLE dataset_shards (
    dataset_id      UUID REFERENCES datasets(id) ON DELETE CASCADE,
    shard_index     INTEGER NOT NULL,          -- Deterministic ordering for epoch shuffling
    cid             TEXT REFERENCES shards(cid) ON DELETE RESTRICT,
    weight          REAL DEFAULT 1.0,          -- Curriculum learning / upsampling weight
    PRIMARY KEY (dataset_id, shard_index)
);

-- 3. Node Edge-Cache Inventory (Heartbeat-updated by Node DaemonSets)
-- Used by scheduler & P2P swarm to know which intranet peers already hold a CID
CREATE TABLE node_cache_inventory (
    node_name       TEXT NOT NULL,
    cid             TEXT REFERENCES shards(cid) ON DELETE CASCADE,
    pinned          BOOLEAN DEFAULT FALSE,
    last_accessed   TIMESTAMPTZ DEFAULT NOW(),
    PRIMARY KEY (node_name, cid)
);
CREATE INDEX idx_cache_cid ON node_cache_inventory(cid);

-- 4. Distributed Training Checkpoints (P2P Seeded)
CREATE TABLE checkpoints (
    id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    run_id          TEXT NOT NULL,
    step            BIGINT NOT NULL,
    cid             TEXT NOT NULL,             -- Root CID of sharded/full checkpoint
    metrics         JSONB DEFAULT '{}'::jsonb, -- e.g., {"val_loss": 1.842}
    created_at      TIMESTAMPTZ DEFAULT NOW(),
    UNIQUE (run_id, step)
);
```

