## 9. Reference Implementation: Async Pre-Fetcher & Zero-Copy `DataLoader`

This Python pattern decouples P2P network transfers from GPU execution:
1. Queries **PostgreSQL** once per epoch for the worker's deterministic slice of Shard CIDs.
2. Uses a background thread pool to pre-fetch `N` lookahead shards via the local **Iroh/IPFS** daemon onto NVMe.
3. Memory-maps (`mmap`) completed local shards straight into PyTorch pinned RAM.

```python
import os
import subprocess
from pathlib import Path
from concurrent.futures import ThreadPoolExecutor
import psycopg
import lance
import torch
from torch.utils.data import IterableDataset, DataLoader

CACHE_DIR = Path(os.environ.get("SHARD_CACHE_DIR", "/var/cache/ml-shards"))


class ContentAddressedPreFetcher:
    """Pulls immutable CIDs from intranet P2P peers onto local NVMe ahead of the GPU."""

    def __init__(self, lookahead: int = 4):
        self.pool = ThreadPoolExecutor(max_workers=lookahead)
        self.futures = {}

    def _fetch_cid_to_nvme(self, cid: str) -> Path:
        target_path = CACHE_DIR / f"{cid}.lance"
        if target_path.exists():
            os.utime(target_path, None)  # Touch mtime for LRU daemon
            return target_path

        tmp_path = CACHE_DIR / f".tmp.{cid}.{os.getpid()}"
        # Trigger local P2P daemon (Iroh CLI / RPC or IPFS API) to swarm-sync blob
        subprocess.run(
            ["iroh", "blobs", "get", cid, "--out", str(tmp_path)],
            check=True,
            capture_output=True,
        )
        # Atomic POSIX rename guarantees DataLoader never sees a half-written shard
        tmp_path.replace(target_path)
        return target_path

    def schedule(self, cid: str):
        if cid not in self.futures:
            self.futures[cid] = self.pool.submit(self._fetch_cid_to_nvme, cid)

    def wait_for(self, cid: str) -> Path:
        self.schedule(cid)
        path = self.futures.pop(cid).result()
        return path


class ZeroCopyShardDataset(IterableDataset):
    def __init__(self, dsn: str, dataset_name: str, version: str, rank: int, world_size: int, epoch: int):
        self.dsn = dsn
        self.dataset_name = dataset_name
        self.version = version
        self.rank = rank
        self.world_size = world_size
        self.epoch = epoch
        self.lookahead = 4

    def _get_worker_manifest(self) -> list[str]:
        """Queries Postgres ONCE per epoch for this rank's shard CIDs."""
        with psycopg.connect(self.dsn) as conn:
            with conn.cursor() as cur:
                cur.execute(
                    """
                    SELECT ds.cid
                    FROM dataset_shards ds
                    JOIN datasets d ON d.id = ds.dataset_id
                    WHERE d.name = %s AND d.version = %s
                    ORDER BY hashtext(ds.cid || %s::text) -- Deterministic epoch shuffle
                    """,
                    (self.dataset_name, self.version, self.epoch),
                )
                all_cids = [row[0] for row in cur.fetchall()]
        # Partition shards evenly across distributed DDP/DiLoCo ranks
        return all_cids[self.rank :: self.world_size]

    def __iter__(self):
        cids = self._get_worker_manifest()
        prefetcher = ContentAddressedPreFetcher(lookahead=self.lookahead)

        # Prime the P2P lookahead pipeline
        for cid in cids[: self.lookahead]:
            prefetcher.schedule(cid)

        for idx, cid in enumerate(cids):
            # Schedule future shard while GPU processes current shard
            if idx + self.lookahead < len(cids):
                prefetcher.schedule(cids[idx + self.lookahead])

            local_shard_path = prefetcher.wait_for(cid)

            # Zero-copy memory-mapped read via Lance / Arrow off local NVMe
            ds = lance.dataset(local_shard_path)
            for batch in ds.to_batches(columns=["input_ids", "labels"], batch_size=32):
                input_ids = torch.from_numpy(batch["input_ids"].to_numpy(zero_copy_only=False))
                labels = torch.from_numpy(batch["labels"].to_numpy(zero_copy_only=False))
                yield input_ids, labels


def build_dataloader(dsn: str, rank: int, world_size: int, epoch: int) -> DataLoader:
    dataset = ZeroCopyShardDataset(dsn, "corp-pretrain", "v2", rank, world_size, epoch)
    return DataLoader(
        dataset,
        batch_size=None,       # Already batched at Arrow/Lance vector level
        num_workers=2,         # Low CPU overhead due to Arrow mmap
        pin_memory=True,       # Enables direct DMA over PCIe to GPU
        prefetch_factor=4,
    )
```

